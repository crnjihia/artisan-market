# ==============================================================================
# Artisan Market Environment Configuration
# ==============================================================================
# Kenyan locale & timezone: Africa/Nairobi
# Default currency: KES (Kenyan Shillings)
# Set USE_MOCKS=true for 100% credential-free local development.
# ==============================================================================

USE_MOCKS=true
APP_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Databases (PostgreSQL database-per-service on port 5432)
# ------------------------------------------------------------------------------
USER_DB_DSN=postgres://postgres:postgres@localhost:5432/user_db?sslmode=disable
PRODUCT_DB_DSN=postgres://postgres:postgres@localhost:5432/product_db?sslmode=disable
ORDER_DB_DSN=postgres://postgres:postgres@localhost:5432/order_db?sslmode=disable
PAYMENT_DB_DSN=postgres://postgres:postgres@localhost:5432/payment_db?sslmode=disable

# ------------------------------------------------------------------------------
# Redis (Shared for shopping cart state & idempotent consumers)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Kafka Broker (Redpanda)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
OUTBOX_POLL_INTERVAL=2s

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-artisan-jwt-key-change-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ------------------------------------------------------------------------------
# gRPC Microservices Bind Addresses
# ------------------------------------------------------------------------------
USER_SERVICE_ADDR=:50051
PRODUCT_SERVICE_ADDR=:50052
ORDER_SERVICE_ADDR=:50053
PAYMENT_SERVICE_ADDR=:50054
PAYMENT_HTTP_ADDR=:8080

# ------------------------------------------------------------------------------
# Gateway & Notification Ports
# ------------------------------------------------------------------------------
GATEWAY_PORT=4000
NOTIFICATION_HTTP_PORT=3001
FRONTEND_PORT=3050

# ------------------------------------------------------------------------------
# Safaricom Daraja M-Pesa (Kenya) Configuration
# Ignored when USE_MOCKS=true. Uses Safaricom Sandbox when enabled.
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=dummy_daraja_consumer_key
MPESA_CONSUMER_SECRET=dummy_daraja_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=http://localhost:8080/mpesa/callback

# ------------------------------------------------------------------------------
# Stripe Configuration (Test Mode)
# Ignored when USE_MOCKS=true.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# ------------------------------------------------------------------------------
# Africa's Talking SMS (Kenya)
# Ignored when USE_MOCKS=true.
# ------------------------------------------------------------------------------
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=dummy_africas_talking_api_key
AFRICAS_TALKING_SENDER_ID=ARTISAN

# ------------------------------------------------------------------------------
# Email / Mailpit (Local SMTP Testing)
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=no-reply@artisanmarket.co.ke
NOTIFICATION_TEST_EMAIL=dev@artisanmarket.co.ke
TEST_PHONE=+254712345678

# ------------------------------------------------------------------------------
# MinIO / S3 Asset Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artisan-products
MINIO_USE_SSL=false

# ------------------------------------------------------------------------------
# OpenTelemetry & Distributed Tracing (Jaeger)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=artisan-market
